# Copy to .env and adjust. Every value here has a sensible default in decobol/config.py.

# --- Local LLM: llama.cpp `llama-server` (OpenAI-compatible API) -------------
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=sk-no-key-required
# Must match the --alias passed to llama-server (scripts/start_llama_server.sh does this).
LLM_MODEL=decobol-local
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=180
# true = no LLM calls at all; agents use their deterministic fallbacks (offline dev / demo safety net).
MOCK_LLM=false

# --- llama-server launch settings (scripts/start_llama_server.sh + docker-compose) ---
LLAMA_MODEL_FILE=qwen2.5-coder-7b-instruct-q4_k_m.gguf
LLAMA_CTX_SIZE=16384
LLAMA_GPU_LAYERS=99
LLAMA_PORT=8080

# --- Flask API ------------------------------------------------------------------
FLASK_PORT=5000
# How many times the validator may send code back to the converter.
MAX_RETRIES=2
# Concurrent conversion jobs.
MAX_WORKERS=2
# Optional Java package for generated classes, e.g. com.legacy.refactored
JAVA_PACKAGE=

# --- React frontend (Vite) ------------------------------------------------------
# Backend URL that the Vite dev server proxies /api to.
VITE_API_PROXY_TARGET=http://localhost:5000

# --- Local filesystem workspace (docs/LOCAL_DEPLOYMENT_WORKFLOW.md) -------------
# INPUT_ROOT/OUTPUT_ROOT are what the backend actually reads/writes — the only
# two paths the fs tools are allowed to touch. Running the backend directly on
# a host (no Docker), point these straight at real folders; defaults (see
# backend/app/config.py) are the vendored examples/lendwise/ and a scratch
# .decobol-output/ folder, so this works with zero configuration.
# INPUT_ROOT=/path/to/your/cobol/repo
# OUTPUT_ROOT=/path/to/your/decobol-output

# DECOBOL_INPUT_DIR/OUTPUT_DIR are docker-compose-only: the *host* paths that
# get bind-mounted into the backend container at /workspace/input (ro) and
# /workspace/output (rw), which is what INPUT_ROOT/OUTPUT_ROOT resolve to
# inside the container. Leave unset to use the same defaults as above.
# DECOBOL_INPUT_DIR=/path/to/your/cobol/repo
# DECOBOL_OUTPUT_DIR=/path/to/your/decobol-output
